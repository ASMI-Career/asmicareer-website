  "unknownTabFallback": null,
  "tracks": [],
  "student": {
    "defaultName": "Student",
    "logRecord": true,
    "scoreParse": "int",
    "branchFromToken": true,
    "counsellorDefaults": { "name": "ASMI Counsellor", "whatsapp": "917410019074", "branch": "ASMI Career Network" },
    "stages": ["Enrolled", "Documents Verified", "Counselled", "Preferences Filed", "Round 1", "Allotted"],
    "defaultProgress": [
      { "id": 1, "label": "Profile",     "status": "completed" },
      { "id": 2, "label": "Counselling", "status": "active" },
      { "id": 3, "label": "Shortlist",   "status": "pending" },
      { "id": 4, "label": "Admission",   "status": "pending" }
    ],
    "categoryRules": {
      "rules": [
        { "contains": ["OBC"], "value": "OBC" },
        { "contains": ["SC"],  "value": "SC" },
        { "contains": ["ST"],  "value": "ST" },
        { "contains": ["EWS"], "value": "EWS" }
      ],
      "default": "General"
    },
    "quotaRules": {
      "rules": [
        { "contains": ["AIQ"], "value": "AIQ" },
        { "contains": ["MQ", "MANAGEMENT", "NRI"], "value": "Management" }
      ],
      "default": "State"
    }
  },
  "dashboard": {
    "headerRole": "NEET Aspirant 2026",
    "heroSubtitle": "Your journey to MBBS 2026 is in progress. Keep going!",
    "badges": [
      { "label": "NEET SCORE",    "field": "score" },
      { "label": "NEET AIR RANK", "field": "rank" },
      { "label": "CATEGORY",      "field": "category" }
    ],
    "categoryLabels": { "General": "General / UR" },
    "redTagKeywords": ["URGENT", "NEET"],
    "newsUrl": "https://asmicareer.in/medical/news",
    "shortlistIcon": "🏥",
    "shortlistEditTab": "predictor",
    "deadlineCount": 4,
    "actionRequiredDocId": "neet-admit"
  },
  "deadlines": { "keepPastResults": true, "useExpiryDate": true, "requireTrackMatch": false, "showTentative": false },
  "documents": {
    "data": "medical",
    "subtitle": "Track every document you need for MBBS counselling and admission.",
    "defaults": { "category": "General", "quota": "State" },
    "quotaLabel": "Quota Type",
    "quotas": [
      { "value": "State",      "label": "State Quota (Maharashtra)" },
      { "value": "AIQ",        "label": "All India Quota (AIQ)" },
      { "value": "Management", "label": "Management / NRI" }
    ]
  },
  "shortlist": {
    "groups": ["MCC", "MH", "OPEN"],
    "groupRules": {
      "byPoolOrQuota": [
        { "group": "MCC",  "pool": "MCC AIQ",    "quota": "aiq" },
        { "group": "MH",   "pool": "MH State",   "quota": "state" },
        { "group": "OPEN", "pool": "Open State", "quota": "open state" }
      ],
      "byState": { "Maharashtra": "MH" },
      "privateGroup": "OPEN",
      "defaultGroup": "MCC"
    }
  },
  "predictor": {
    "title": "📊 NEET Rank Predictor",
